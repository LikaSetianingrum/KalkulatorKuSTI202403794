<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F0F7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sensor Monitor"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#5E35B1"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Card Accelerometer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Accelerometer (Gerakan dan Kemiringan)"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#5E35B1"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/textAccel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Menunggu data sensor..."
                android:textSize="14sp"
                android:textColor="#333333"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <!-- Card Gyroscope -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔄 Gyroscope (Kecepatan Putar HP)"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#7E57C2"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/textGyro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Menunggu data sensor..."
                android:textSize="14sp"
                android:textColor="#333333"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>